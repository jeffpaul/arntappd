# Copy to .env.local for local development. Never commit real values.

# Untappd API app (https://untappd.com/api/dashboard). Required for beer lookups.
UNTAPPD_CLIENT_ID=
UNTAPPD_CLIENT_SECRET=

# Optional, development only until Untappd sign-in lands (MVP step 3).
# A personal Untappd access token turns on "You" and "Friends" ratings.
UNTAPPD_ACCESS_TOKEN=

# Claude API key for reading menu photos. Without it, the built-in sample menu
# uses a recorded reading and uploaded photos cannot be scanned.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
