# Copy to .env.local for local development. Never commit real values.

# Untappd API app (https://untappd.com/api/dashboard). Required for beer lookups and sign-in.
UNTAPPD_CLIENT_ID=
UNTAPPD_CLIENT_SECRET=

# Claude API key for reading menu photos. Without it, the built-in sample menu
# uses a stored reading and uploaded photos cannot be scanned.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Encrypts the sign-in cookie. Any long random string. Optional in development
# (a temporary one is used); required in production. Render generates it.
SESSION_SECRET=

# Public origin of the app, used for the Untappd callback URL
# (<APP_BASE_URL>/api/auth/callback/untappd). Defaults to http://localhost:3000
# in development and to RENDER_EXTERNAL_URL on Render.
APP_BASE_URL=

# Optional, development only: an Untappd access token used for You and Friends
# ratings when nobody is signed in.
UNTAPPD_ACCESS_TOKEN=
